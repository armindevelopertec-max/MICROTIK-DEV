# ---------------------------------------------------------------------------
# Configuración del generador de tickets QR (scripts/ticket_qr.py)
#
# Copia este archivo como .env y ajusta los valores.
#   cp .env.example .env
#
# .env está en .gitignore: no se versiona.
# ---------------------------------------------------------------------------

# --- RouterOS API (CHR) ----------------------------------------------------
# El laboratorio reenvía 127.0.0.1:8728 al CHR vía QEMU (iniciar-lab.sh).
MIKROTIK_HOST=127.0.0.1
MIKROTIK_PORT=8728
MIKROTIK_USER=admin
MIKROTIK_PASSWORD=Dahua2026

# --- WiFi del laboratorio (hostapd) ---------------------------------------
MIKROTIK_SSID=MIKROTIK-LAB
MIKROTIK_WIFI_PASSWORD=mikrotik123

# --- Portal / hotspot ------------------------------------------------------
# Déjalo vacío para detectarlo desde /ip/hotspot/profile (hotspot-address).
MIKROTIK_PORTAL=
MIKROTIK_PROFILE=qr-ticket
MIKROTIK_PREFIX=QR

# Límite de velocidad por ticket, p. ej. 5M/5M (subida/bajada).
# Vacío = sin límite (el CHR sin licencia ya limita a 1 Mbps).
MIKROTIK_RATE_LIMIT=

# Carpeta donde se guardan los PNG/CSV/HTML de los lotes.
MIKROTIK_TICKETS_DIR=tickets
